<mxfile host="app.diagrams.net"><diagram id="flow" name="M3 complete flow"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="3" value="Ways in" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#c4ccd4;dashed=1;verticalAlign=top;align=left;spacingLeft=10;fontSize=13;fontColor=#33414f;arcSize=3;" vertex="1" parent="1"><mxGeometry x="496" y="950" width="222" height="224" as="geometry"/></mxCell><mxCell id="4" value="Editor (one file at a time)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#c4ccd4;dashed=1;verticalAlign=top;align=left;spacingLeft=10;fontSize=13;fontColor=#33414f;arcSize=3;" vertex="1" parent="1"><mxGeometry x="11" y="1274" width="550" height="382" as="geometry"/></mxCell><mxCell id="5" value="Library scan" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#c4ccd4;dashed=1;verticalAlign=top;align=left;spacingLeft=10;fontSize=13;fontColor=#33414f;arcSize=3;" vertex="1" parent="1"><mxGeometry x="214" y="1074" width="274" height="104" as="geometry"/></mxCell><mxCell id="6" value="Queue: items you add by hand" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#c4ccd4;dashed=1;verticalAlign=top;align=left;spacingLeft=10;fontSize=13;fontColor=#33414f;arcSize=3;" vertex="1" parent="1"><mxGeometry x="569" y="1186" width="313" height="404" as="geometry"/></mxCell><mxCell id="7" value="Media Intake: watched folders" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#c4ccd4;dashed=1;verticalAlign=top;align=left;spacingLeft=10;fontSize=13;fontColor=#33414f;arcSize=3;" vertex="1" parent="1"><mxGeometry x="890" y="8" width="844" height="1573" as="geometry"/></mxCell><mxCell id="8" value="Queue run" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#c4ccd4;dashed=1;verticalAlign=top;align=left;spacingLeft=10;fontSize=13;fontColor=#33414f;arcSize=3;" vertex="1" parent="1"><mxGeometry x="531" y="1664" width="320" height="199" as="geometry"/></mxCell><mxCell id="9" value="Delivery (Preferences &gt; Sources &gt; Media Locations)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#c4ccd4;dashed=1;verticalAlign=top;align=left;spacingLeft=10;fontSize=13;fontColor=#33414f;arcSize=3;" vertex="1" parent="1"><mxGeometry x="8" y="1880" width="594" height="489" as="geometry"/></mxCell><mxCell id="10" value="Afterwards" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#c4ccd4;dashed=1;verticalAlign=top;align=left;spacingLeft=10;fontSize=13;fontColor=#33414f;arcSize=3;" vertex="1" parent="1"><mxGeometry x="57" y="2396" width="631" height="363" as="geometry"/></mxCell><mxCell id="11" value="&lt;b&gt;Welcome window&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Tag One File&lt;br&gt;Merge and Tag Files&lt;br&gt;Scan Library for Missing Metadata&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2b5d8a;strokeColor=#2b5d8a;fontColor=white;fontSize=12;" vertex="1" parent="1"><mxGeometry x="510" y="986" width="191" height="54" as="geometry"/></mxCell><mxCell id="12" value="&lt;b&gt;Add Item, drag and drop,&lt;br&gt;File &amp;gt; Open&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;files or folders you add yourself&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2b5d8a;strokeColor=#2b5d8a;fontColor=white;fontSize=12;" vertex="1" parent="1"><mxGeometry x="510" y="1114" width="195" height="46" as="geometry"/></mxCell><mxCell id="13" value="&lt;b&gt;Incoming Folders&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;one or more, set on the Media Intake tab&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2b5d8a;strokeColor=#2b5d8a;fontColor=white;fontSize=12;" vertex="1" parent="1"><mxGeometry x="938" y="44" width="223" height="36" as="geometry"/></mxCell><mxCell id="14" value="&lt;b&gt;Editor&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;edit tags, artwork, tracks, chapters&lt;br&gt;Search Metadata asks your enabled providers&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff4d6;strokeColor=#c79a1c;fontColor=#1b2733;fontSize=12;" vertex="1" parent="1"><mxGeometry x="227" y="1310" width="248" height="44" as="geometry"/></mxCell><mxCell id="15" value="&lt;b&gt;Save / Save &amp;amp; Close&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;tags written into the file itself&lt;br&gt;(in place: no original kept, nothing to the Trash)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e6f0fa;strokeColor=#2b5d8a;fontColor=#1b2733;fontSize=12;" vertex="1" parent="1"><mxGeometry x="25" y="1437" width="255" height="44" as="geometry"/></mxCell><mxCell id="16" value="&lt;b&gt;Name and folder&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;renamed by the Filename rules, Movie or&lt;br&gt;Show/Season folders applied (not if no Title is tagged)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e6f0fa;strokeColor=#2b5d8a;fontColor=#1b2733;fontSize=12;" vertex="1" parent="1"><mxGeometry x="89" y="1598" width="289" height="44" as="geometry"/></mxCell><mxCell id="17" value="&lt;b&gt;Send to Queue&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;the open file becomes a Queue item instead&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e6f0fa;strokeColor=#2b5d8a;fontColor=#1b2733;fontSize=12;" vertex="1" parent="1"><mxGeometry x="306" y="1441" width="241" height="36" as="geometry"/></mxCell><mxCell id="18" value="&lt;b&gt;Library scan&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;pick a folder; lists .mp4 / .m4v / .mov files&lt;br&gt;missing Title, Release Date, Rating or Studio.&lt;br&gt;Reports only, changes nothing&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff4d6;strokeColor=#c79a1c;fontColor=#1b2733;fontSize=12;" vertex="1" parent="1"><mxGeometry x="228" y="1110" width="246" height="54" as="geometry"/></mxCell><mxCell id="19" value="&lt;b&gt;Name looks like a&lt;br&gt;TV episode?&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#f4f4f4;strokeColor=#777777;fontColor=#1b2733;fontSize=12;" vertex="1" parent="1"><mxGeometry x="583" y="1300" width="258" height="64" as="geometry"/></mxCell><mxCell id="20" value="&lt;b&gt;Plain Queue item&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;one row per file; Queue Options decide which&lt;br&gt;actions run. Edit re-reads the file from disk;&lt;br&gt;if it was moved: Find...&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e6f0fa;strokeColor=#2b5d8a;fontColor=#1b2733;fontSize=12;" vertex="1" parent="1"><mxGeometry x="583" y="1522" width="245" height="54" as="geometry"/></mxCell><mxCell id="21" value="&lt;b&gt;Merge button&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;select 2 or more items, Merge Review sheet,&lt;br&gt;choose where to save, lossless merge&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff4d6;strokeColor=#c79a1c;fontColor=#1b2733;fontSize=12;" vertex="1" parent="1"><mxGeometry x="624" y="1222" width="244" height="44" as="geometry"/></mxCell><mxCell id="22" value="&lt;b&gt;Discovery&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Automatically watch (folder watcher + 20 s check)&lt;br&gt;or the Scan Now button&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e6f0fa;strokeColor=#2b5d8a;fontColor=#1b2733;fontSize=12;" vertex="1" parent="1"><mxGeometry x="913" y="111" width="272" height="44" as="geometry"/></mxCell><mxCell id="23" value="&lt;b&gt;Filter and settle&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;skips hidden files, delivery folders and unfinished&lt;br&gt;downloads; waits until sizes stop changing&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e6f0fa;strokeColor=#2b5d8a;fontColor=#1b2733;fontSize=12;" vertex="1" parent="1"><mxGeometry x="916" y="186" width="266" height="44" as="geometry"/></mxCell><mxCell id="24" value="&lt;b&gt;TV episode?&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#f4f4f4;strokeColor=#777777;fontColor=#1b2733;fontSize=12;" vertex="1" parent="1"><mxGeometry x="971" y="261" width="157" height="36" as="geometry"/></mxCell><mxCell id="25" value="&lt;b&gt;TV Shows tab&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;its own list in the Queue window; same steps&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e6f0fa;strokeColor=#2b5d8a;fontColor=#1b2733;fontSize=12;" vertex="1" parent="1"><mxGeometry x="904" y="1441" width="246" height="36" as="geometry"/></mxCell><mxCell id="26" value="&lt;b&gt;Release row in Movies Queue&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;one folder of files&lt;br&gt;(a loose file gets a folder of its own)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e6f0fa;strokeColor=#2b5d8a;fontColor=#1b2733;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1078" y="338" width="224" height="44" as="geometry"/></mxCell><mxCell id="27" value="&lt;b&gt;Auto-approve on and&lt;br&gt;confident title match?&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#f4f4f4;strokeColor=#777777;fontColor=#1b2733;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1113" y="413" width="314" height="64" as="geometry"/></mxCell><mxCell id="28" value="&lt;b&gt;Naming Review&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;approve, edit the name, or reject&lt;br&gt;Search All Providers&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff4d6;strokeColor=#c79a1c;fontColor=#1b2733;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1178" y="518" width="185" height="44" as="geometry"/></mxCell><mxCell id="29" value="&lt;b&gt;Rejected&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;row stays parked in the Queue&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f9dede;strokeColor=#b04a4a;fontColor=#1b2733;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1136" y="603" width="173" height="36" as="geometry"/></mxCell><mxCell id="30" value="&lt;b&gt;Folder renamed&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Title Vol N [Studio] (Year)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e6f0fa;strokeColor=#2b5d8a;fontColor=#1b2733;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1339" y="603" width="147" height="36" as="geometry"/></mxCell><mxCell id="31" value="&lt;b&gt;One file or several?&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#f4f4f4;strokeColor=#777777;fontColor=#1b2733;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1347" y="670" width="245" height="36" as="geometry"/></mxCell><mxCell id="32" value="&lt;b&gt;Online match for the&lt;br&gt;name, confident?&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#f4f4f4;strokeColor=#777777;fontColor=#1b2733;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1418" y="1300" width="298" height="64" as="geometry"/></mxCell><mxCell id="33" value="&lt;b&gt;Metadata Review&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;search again with other words, pick a result,&lt;br&gt;choose Portrait or Landscape art,&lt;br&gt;or Continue Without Metadata.&lt;br&gt;Search with menu: pick another source&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff4d6;strokeColor=#c79a1c;fontColor=#1b2733;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1479" y="1427" width="241" height="64" as="geometry"/></mxCell><mxCell id="34" value="&lt;b&gt;Folder already holds&lt;br&gt;a merged file?&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#f4f4f4;strokeColor=#777777;fontColor=#1b2733;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1324" y="747" width="292" height="64" as="geometry"/></mxCell><mxCell id="35" value="&lt;b&gt;Already merged: review&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;use the merged file, or merge the parts anyway&lt;br&gt;(the old merged file is kept as &quot; - OLD&quot;)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff4d6;strokeColor=#c79a1c;fontColor=#1b2733;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1375" y="991" width="257" height="44" as="geometry"/></mxCell><mxCell id="36" value="&lt;b&gt;Auto-merge on, parts&lt;br&gt;numbered and compatible?&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#f4f4f4;strokeColor=#777777;fontColor=#1b2733;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1069" y="852" width="384" height="64" as="geometry"/></mxCell><mxCell id="37" value="&lt;b&gt;Auto-merge&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;starts after about 1 s&lt;br&gt;(opening the row cancels it)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e6f0fa;strokeColor=#2b5d8a;fontColor=#1b2733;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1185" y="991" width="160" height="44" as="geometry"/></mxCell><mxCell id="38" value="&lt;b&gt;Merge Review&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;pick files (untick a file to leave it out),&lt;br&gt;drag into order, compatibility check&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff4d6;strokeColor=#c79a1c;fontColor=#1b2733;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1175" y="1437" width="210" height="44" as="geometry"/></mxCell><mxCell id="39" value="&lt;b&gt;Lossless merge&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;no re-encode, a chapter at each join;&lt;br&gt;written under a hidden name, renamed when complete;&lt;br&gt;progress shown on the row, parts marked Merged afterwards&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e6f0fa;strokeColor=#2b5d8a;fontColor=#1b2733;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1172" y="1110" width="321" height="54" as="geometry"/></mxCell><mxCell id="40" value="&lt;b&gt;Merge failed&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;reason shown on the row;&lt;br&gt;reopen and retry&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f9dede;strokeColor=#b04a4a;fontColor=#1b2733;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1243" y="1310" width="150" height="44" as="geometry"/></mxCell><mxCell id="41" value="&lt;b&gt;Item ready in the Queue&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;metadata search and delivery actions attached&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e6f0fa;strokeColor=#2b5d8a;fontColor=#1b2733;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1307" y="1531" width="255" height="36" as="geometry"/></mxCell><mxCell id="42" value="&lt;b&gt;Start&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Auto-Start, or the Start button.&lt;br&gt;Movies and TV Shows tabs take turns, one file&lt;br&gt;at a time (or both at once, if you set that)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e6f0fa;strokeColor=#2b5d8a;fontColor=#1b2733;fontSize=12;" vertex="1" parent="1"><mxGeometry x="582" y="1700" width="249" height="54" as="geometry"/></mxCell><mxCell id="43" value="&lt;b&gt;Actions, then write the file&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;clear old tags, search metadata and artwork (a release&lt;br&gt;searches by its approved name), set filename,&lt;br&gt;subtitles, track tidy-ups, optimize&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e6f0fa;strokeColor=#2b5d8a;fontColor=#1b2733;fontSize=12;" vertex="1" parent="1"><mxGeometry x="545" y="1795" width="292" height="54" as="geometry"/></mxCell><mxCell id="44" value="&lt;b&gt;Deliver automatically?&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#f4f4f4;strokeColor=#777777;fontColor=#1b2733;fontSize=12;" vertex="1" parent="1"><mxGeometry x="246" y="1916" width="277" height="36" as="geometry"/></mxCell><mxCell id="45" value="&lt;b&gt;Staging folder&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Ready for Media Library: your check before the library.&lt;br&gt;Rules are ignored. No staging folder set: file stays put&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e6f0fa;strokeColor=#2b5d8a;fontColor=#1b2733;fontSize=12;" vertex="1" parent="1"><mxGeometry x="299" y="2072" width="289" height="44" as="geometry"/></mxCell><mxCell id="46" value="&lt;b&gt;First enabled rule&lt;br&gt;that matches?&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#f4f4f4;strokeColor=#777777;fontColor=#1b2733;fontSize=12;" vertex="1" parent="1"><mxGeometry x="148" y="1993" width="258" height="64" as="geometry"/></mxCell><mxCell id="47" value="&lt;b&gt;The rule's folder&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Movies and TV Shows have separate rule lists&lt;br&gt;(genre, rating, year, ...)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e6f0fa;strokeColor=#2b5d8a;fontColor=#1b2733;fontSize=12;" vertex="1" parent="1"><mxGeometry x="312" y="2131" width="249" height="44" as="geometry"/></mxCell><mxCell id="48" value="&lt;b&gt;Default destination&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Apple TV Automatically Add folder;&lt;br&gt;blank first row follows the Apple TV app's setting&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e6f0fa;strokeColor=#2b5d8a;fontColor=#1b2733;fontSize=12;" vertex="1" parent="1"><mxGeometry x="22" y="2131" width="264" height="44" as="geometry"/></mxCell><mxCell id="49" value="&lt;b&gt;Automatically Add&lt;br&gt;folder?&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#f4f4f4;strokeColor=#777777;fontColor=#1b2733;fontSize=12;" vertex="1" parent="1"><mxGeometry x="214" y="2206" width="262" height="64" as="geometry"/></mxCell><mxCell id="50" value="&lt;b&gt;Finished file goes in alone&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;the Apple TV app files it from there&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e6f0fa;strokeColor=#2b5d8a;fontColor=#1b2733;fontSize=12;" vertex="1" parent="1"><mxGeometry x="111" y="2315" width="201" height="36" as="geometry"/></mxCell><mxCell id="51" value="&lt;b&gt;Folder moved in&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;release folder, or movie / Show/Season folder;&lt;br&gt;&quot;name 2&quot;, &quot;name 3&quot; if the name is taken&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e6f0fa;strokeColor=#2b5d8a;fontColor=#1b2733;fontSize=12;" vertex="1" parent="1"><mxGeometry x="338" y="2311" width="250" height="44" as="geometry"/></mxCell><mxCell id="52" value="&lt;b&gt;Clean up processed&lt;br&gt;files on?&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#f4f4f4;strokeColor=#777777;fontColor=#1b2733;fontSize=12;" vertex="1" parent="1"><mxGeometry x="71" y="2432" width="282" height="64" as="geometry"/></mxCell><mxCell id="53" value="&lt;b&gt;Originals to the Trash&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;merged parts / unconverted source, logged&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#efe6f5;strokeColor=#8061a0;fontColor=#1b2733;fontSize=12;" vertex="1" parent="1"><mxGeometry x="83" y="2537" width="234" height="36" as="geometry"/></mxCell><mxCell id="54" value="&lt;b&gt;Remove empty folders&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;if on: Incoming and staging folders, to the Trash, logged&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#efe6f5;strokeColor=#8061a0;fontColor=#1b2733;fontSize=12;" vertex="1" parent="1"><mxGeometry x="378" y="2446" width="296" height="36" as="geometry"/></mxCell><mxCell id="55" value="&lt;b&gt;Remove finished items&lt;br&gt;automatically on?&lt;/b&gt;" style="rhombus;whiteSpace=wr